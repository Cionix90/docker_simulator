<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.6">
  <world name="test_2">

    <physics name="1ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.1 0.1 0.1 1.0</ambient>
      <background>0 0 0 1.0</background>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin name='rgl::RGLServerPluginManager' filename='RGLServerPluginManager'>
        <do_ignore_entities_in_lidar_link>true</do_ignore_entities_in_lidar_link>
    </plugin>

    <atmosphere type="adiabatic">
      <temperature>288</temperature>
      <temperature_gradient>0.4</temperature_gradient>
    </atmosphere>
    <!-- light first room -->
    <light type="point" name="sun_1">
      <cast_shadows>true</cast_shadows>
      <pose>-3 -27 17 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light type="point" name="sun_2">
      <cast_shadows>true</cast_shadows>
      <pose>-26.5 -45 12 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light type="point" name="sun_3">
      <cast_shadows>true</cast_shadows>
      <pose>11.5 -36 8.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light type="point" name="sun_4">
      <cast_shadows>true</cast_shadows>
      <pose>28.5 -7 5.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- second room -->
    <light type="point" name="sun_5">
      <cast_shadows>true</cast_shadows>
      <pose>16 13.3 4.3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

     <!-- second room -->
    <light type="point" name="sun_6">
      <cast_shadows>true</cast_shadows>
      <pose>16 56.5 4.3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
   <!--The staging area-->
    <include>
      <static>true</static>
      <name>staging_area</name>
      <pose>0 0 0 0 0 -3.141593</pose>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Urban%20Starting%20Area</uri>
    </include>

    <!--Tunnel tiles and artifacts-->
    <include>
      <name>tile_1</name>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Urban%20Service%20Room%20Straight</uri>
      <pose>16.021 16.06 0.919 0 0 -3.141593</pose>
    </include>

    <include>
      <name>tile_2</name>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Urban%20Service%20Room%20Centered</uri>
      <pose>16.02099 15.06001 0.919002 0 0 0</pose>
    </include>

    
  </world>
</sdf>